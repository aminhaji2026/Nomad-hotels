{
  "name": "nomadstay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:customer": "tsc -b && VITE_APP_SURFACE=customer vite build",
    "build:ops": "tsc -b && VITE_APP_SURFACE=ops vite build",
    "dev:ops": "VITE_APP_SURFACE=ops vite",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "dev:api": "node server/index.js",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"PORT=3001 DATA_DIR=./data UPLOAD_DIR=./uploads node server/index.js\"",
    "server": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "serve": "^14.2.6",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
